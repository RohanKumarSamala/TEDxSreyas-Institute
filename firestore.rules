rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ticket Slabs ──
    // Public read (prices, availability) — only admins can write full docs
    match /ticket_slabs/{slabId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeCount']);
      allow write: if request.auth != null;
    }

    // ── Registrations ──
    match /registrations/{docId} {
      // Allowed public read to enable ticket counting and duplicate checks
      allow read: if true;

      // Allow creation only if status is 'reserved' (new reservation)
      allow create: if request.resource.data.status == 'reserved'
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.slabId is string;

      // Allow updates with restrictions:
      // - Cannot set status directly to 'approved' from client (admin only)
      // - Can transition: reserved → expired, reserved → pending_verification
      allow update: if (
        // Client: reserved → pending_verification (payment submission)
        (resource.data.status == 'reserved'
         && request.resource.data.status == 'pending_verification'
         && request.resource.data.utrNumber is string
         && request.resource.data.screenshotUrl is string)
        ||
        // Client: reserved → expired (timer expiry / cancel)
        (resource.data.status == 'reserved'
         && request.resource.data.status == 'expired')
        ||
        // Admin: any transition (authenticated)
        request.auth != null
      );

      // Only admins can delete
      allow delete: if request.auth != null;
    }

    // ── Counters (serial numbers for ticket IDs) ──
    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Default deny ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
